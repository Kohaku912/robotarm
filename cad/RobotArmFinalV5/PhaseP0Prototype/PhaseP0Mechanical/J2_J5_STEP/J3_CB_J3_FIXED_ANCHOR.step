#837 = UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.E-07),#834,
  'distance_accuracy_value','confusion accuracy');
#838 = PRODUCT_RELATED_PRODUCT_CATEGORY('part',$,(#7));
